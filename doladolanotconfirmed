<script>
const MISSION_BUDGET=175;
const parts=[
 {id:'smallRocket',cat:'Rocket',name:'Small Rocket',cost:50,weight:0,capacity:250,desc:'Light launch vehicle. Best suited for a compact Moon spacecraft.',effect:'250 kg payload limit'},
 {id:'heavyRocket',cat:'Rocket',name:'Heavy Rocket',cost:90,weight:0,capacity:550,desc:'Heavy-lift launch vehicle for larger, more powerful spacecraft.',effect:'550 kg payload limit'},
 {id:'solar',cat:'Power',name:'Solar Panels',cost:15,weight:40,desc:'Generates power in sunlight. Full output near the Moon, half output near Mars, none in shadow.',effect:'Solar recharge'},
 {id:'rtg',cat:'Power',name:'Nuclear Battery (RTG)',cost:60,weight:120,desc:'A radioisotope power system that supplies steady energy, even in darkness.',effect:'Reliable power anywhere'},
 {id:'smallAntenna',cat:'Radio Dish',name:'Small Antenna',cost:15,weight:20,capacity:20,desc:'A light antenna for sending smaller batches of science data.',effect:'20 science / turn'},
 {id:'largeDish',cat:'Radio Dish',name:'Large Radio Dish',cost:35,weight:80,capacity:50,desc:'A powerful dish that sends more data, but uses extra battery power.',effect:'50 science / turn · extra power'},
 {id:'basicCam',cat:'Camera',name:'Basic Camera',cost:15,weight:30,science:25,desc:'Reliable survey camera for crater and landing-zone images.',effect:'25 science / photo'},
 {id:'hdCam',cat:'Camera',name:'HD Telescope Camera',cost:35,weight:110,science:60,desc:'High-resolution telescope camera. Produces more science but uses extra power.',effect:'60 science / photo · extra power'},
 {id:'shield',cat:'Protection',name:'Radiation Shielding · OPTIONAL',cost:15,weight:50,desc:'Optional extra protection against solar storms. Add it only if your budget and payload allow; the mission can launch without it.',effect:'Optional · blocks Solar Storm damage'}
];
const groups=['Rocket','Power','Radio Dish','Camera','Protection'];const requiredGroups=['Rocket','Power','Radio Dish','Camera'];let mission='moon',selected={},game={},emTimer=null,flightTimer=null;let astronautGender='',astronautName='';
function show(id){document.querySelectorAll('.screen').forEach(s=>s.classList.remove('active'));document.getElementById(id).classList.add('active');window.scrollTo(0,0)}
function selectAstronaut(gender){astronautGender=gender;astronautName=gender==='female'?'Astronaut Hermoine':'Astronaut Harry Ouroborus';document.getElementById('femaleProfile').classList.toggle('selected',gender==='female');document.getElementById('maleProfile').classList.toggle('selected',gender==='male');document.getElementById('profileStatus').textContent='Selected: '+astronautName+' · You are the Lead Mission Director.';document.getElementById('enterMissionBtn').disabled=false;document.getElementById('directorNameTag').textContent=astronautName;}
function showMissionSelect(){if(!astronautName){document.getElementById('profileStatus').textContent='Choose Female or Male Astronaut before continuing.';return}show('missionSelect')}function backIntro(){show('intro')}
function selectMission(m){mission=m;document.getElementById('moonCard').classList.toggle('selected',m==='moon');document.getElementById('marsCard').classList.toggle('selected',m==='mars')}
function openShop(){selected={};renderShop();show('shop')}
function renderShop(){let html='';groups.forEach(g=>{html+=`<div style="grid-column:1/-1;margin:8px 0 -5px"><div class="eyebrow">${g.toUpperCase()}${g==='Protection'?' · OPTIONAL — NOT REQUIRED FOR LAUNCH':''}</div></div>`;parts.filter(p=>p.cat===g).forEach(p=>{let active=selected[g]===p.id;html+=`<div class="part ${active?'selected':''}"><div style="display:flex;justify-content:space-between;gap:8px"><h3>${p.name}</h3><span class="pill">$${p.cost}M</span></div><p>${p.desc}</p><div class="meta"><span class="pill">${p.weight} kg</span><span class="pill">${p.effect}</span></div><button class="${active?'success':''}" onclick="choosePart('${g}','${p.id}')">${active?'✓ SELECTED':'SELECT PART'}</button></div>`})});document.getElementById('shopGrid').innerHTML=html;updateBuild()}
function choosePart(g,id){if(g==='Protection'&&selected[g]===id){delete selected[g]}else{selected[g]=id}renderShop()}
function getPart(g){return parts.find(p=>p.id===selected[g])}
function buildStats(){let chosen=Object.values(selected).map(id=>parts.find(p=>p.id===id)).filter(Boolean);return{cost:chosen.reduce((s,p)=>s+p.cost,0),weight:chosen.reduce((s,p)=>s+p.weight,0),rocket:getPart('Rocket'),power:getPart('Power'),radio:getPart('Radio Dish'),camera:getPart('Camera'),shield:getPart('Protection')}}
function updateBuild(){let s=buildStats(),cap=s.rocket?.capacity||0;document.getElementById('costText').textContent=`$${s.cost}M`;document.getElementById('weightText').textContent=`${s.weight} / ${cap} kg`;document.getElementById('cashText').textContent=`$${MISSION_BUDGET-s.cost}M`;document.getElementById('cameraText').textContent=s.camera?`${s.camera.science} pts`:'—';document.getElementById('radioText').textContent=s.radio?`${s.radio.capacity} pts`:'—';document.getElementById('powerText').textContent=s.power?.name||'—';document.getElementById('costBar').style.width=Math.min(100,s.cost/MISSION_BUDGET*100)+'%';document.getElementById('weightBar').style.width=cap?Math.min(100,s.weight/cap*100)+'%':'0%';let missing=requiredGroups.filter(g=>!selected[g]);let errors=[];if(missing.length)errors.push('Still need: '+missing.join(', ')+'.');if(s.cost>MISSION_BUDGET)errors.push('Budget exceeded. Remove equipment.');if(s.rocket&&s.weight>cap)errors.push('Payload is too heavy for this rocket.');let ok=!errors.length;document.getElementById('buildMessage').textContent=ok?'✓ Build approved. Your spacecraft is ready for launch.':errors.join(' ');document.getElementById('buildMessage').className='small '+(ok?'good':'warning');document.getElementById('launchBtn').disabled=!ok}
function log(msg){let el=document.getElementById('log');el.innerHTML=`<div>• ${msg}</div>`+el.innerHTML}
function beginOrbitalOperations(){show('flight');document.getElementById('flightTitle').textContent=mission==='moon'?'Moon Orbital Operations':'Mars Orbital Operations';document.getElementById('flightSub').textContent=`Robotic spacecraft · ${game.maxTurns} turns · ${game.goal} science points required`;document.getElementById('planet').className='planet '+mission;document.getElementById('log').innerHTML='';log('Transfer complete. Robotic spacecraft inserted into '+(mission==='moon'?'lunar':'Martian')+' orbit.');log(`Mission goal: transmit ${game.goal} science points to Earth.`);updateFlight();startClock()}
function launchMission(){let s=buildStats();if(requiredGroups.some(g=>!selected[g])||s.cost>MISSION_BUDGET||s.weight>s.rocket.capacity)return;game={...s,mission,turn:1,maxTurns:mission==='moon'?10:12,goal:mission==='moon'?100:200,battery:100,fuel:100,stored:0,sent:0,pending:0,pendingQueue:[],turnsLeft:mission==='moon'?10:12,seconds:mission==='moon'?120:180,shielded:!!s.shield,signalSlow:1,brave:0,events:[],eventIndex:0,photoDisabled:0,solarHalf:0,dusty:false,cameraBroken:false,computerDead:false,done:false,history:[],turnAction:false,queued:[],lastAction:'',};game.events=shuffle(['overheat','storm','freeze','dust','micro','eclipse','lag']).slice(0,Math.random()<.5?2:3);game.eventTurns=mission==='moon'?[5,8,9]:[6,9,11];game.eventTurns=game.eventTurns.slice(0,game.events.length);show('travel');document.getElementById('travelTitle').textContent=mission==='mars'?'Earth → Mars: deep-space cruise':'Earth → Moon: lunar transfer';document.getElementById('travelText').textContent=mission==='mars'?'The heavy-lift rocket has delivered your robotic scout into space. Watch it cross the dark distance toward the red planet, then begin the orbital survey.':'Your robotic scout leaves Earth orbit and follows its transfer path toward the Moon. Prepare to map craters and possible water-ice sites.';document.getElementById('travelPlanet').className='travel-destination '+mission;document.getElementById('travelCaption').textContent=mission==='mars'?'EARTH DEPARTURE · DEEP SPACE CRUISE · MARS APPROACH':'EARTH DEPARTURE · LUNAR TRANSFER · MOON APPROACH';document.getElementById('travelFact').textContent='This is an uncrewed robotic mission. The spacecraft travels alone; the crew stays at NASA Mission Control and guides it remotely.'}
function shuffle(a){for(let i=a.length-1;i>0;i--){let j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]]}return a}
function startClock(){clearInterval(flightTimer);flightTimer=setInterval(()=>{if(!game||game.done||game.timerPaused)return;game.seconds--;document.getElementById('timerVal').textContent=fmt(game.seconds);if(game.seconds<=0){clearInterval(flightTimer);finish(false,'The mission clock reached zero before enough science data arrived at Earth.')}} ,1000)}function fmt(s){return `${String(Math.floor(Math.max(0,s)/60)).padStart(2,'0')}:${String(Math.max(0,s)%60).padStart(2,'0')}`}
function isShadow(t=game.turn){return mission==='moon'?[3,7,8].includes(t):[4,8,11].includes(t)}function hasLOS(t=game.turn){return !isShadow(t)}function updateFlight(){let g=game;document.getElementById('turnVal').textContent=`${g.turn} / ${g.maxTurns}`;document.getElementById('batteryVal').textContent=Math.round(g.battery)+'%';document.getElementById('batteryBar').style.width=Math.max(0,g.battery)+'%';document.getElementById('fuelVal').textContent=Math.round(g.fuel)+'%';document.getElementById('fuelBar').style.width=Math.max(0,g.fuel)+'%';document.getElementById('batteryBar').style.background=g.battery<25?'#ff6877':'linear-gradient(90deg,#34c6f2,#6be5a6)';document.getElementById('sentVal').textContent=`${Math.floor(g.sent)} / ${g.goal} science points`;document.getElementById('timerVal').textContent=fmt(g.seconds);document.getElementById('storedVal').textContent=`${Math.floor(g.stored)} pts`;document.getElementById('pendingVal').textContent=`${Math.floor(g.pending)} pts`;document.getElementById('photoRate').textContent=`${g.camera.science} pts`;document.getElementById('radioRate').textContent=`${g.radio.capacity} pts`;document.getElementById('signalVal').textContent=hasLOS()?'Clear now':'Blocked by planet';document.getElementById('powerStatus').textContent=g.power.name;document.getElementById('cameraStatus').textContent=g.cameraBroken?'FRIED':g.camera.name;document.getElementById('radioStatus').textContent=g.radio.name;document.getElementById('shieldStatus').textContent=g.shielded?'Installed':'Not installed';document.getElementById('signalSpeed').textContent=Math.round(g.signalSlow*100)+'%';let shadow=isShadow();document.getElementById('spaceScene').classList.toggle('shadow',shadow);document.getElementById('sceneLabel').textContent=(mission==='moon'?'LUNAR':'MARTIAN')+' ORBIT · '+(shadow?'PLANET SHADOW':'SUNLIT SIDE');document.getElementById('sceneStatus').textContent='Signal to Earth: '+(hasLOS()?'CLEAR':'BLOCKED BY PLANET');let disabled=g.turnAction||g.done;document.getElementById('photoBtn').disabled=disabled||g.cameraBroken||g.photoDisabled>0||g.battery<photoCost();document.getElementById('sendBtn').disabled=disabled||!hasLOS()||g.stored<=0||g.battery<radioCost();document.getElementById('rechargeBtn').disabled=disabled;document.getElementById('actionHint').textContent=g.turnAction?'ACTION COMPLETE · ADVANCE':'ONE ACTION PER TURN';}
function photoCost(){return game.camera.id==='hdCam'?14:7}function radioCost(){return game.radio.id==='largeDish'?9:8}
function spend(n){game.battery=Math.max(0,game.battery-n);if(game.battery<=0){updateFlight();finish(false,'The spacecraft battery reached 0%. The spacecraft lost power before the mission could be completed.');return false}return true}
let aimLocked=false,aimPoint={x:.5,y:.5},aimZoom=1,aimAngle=0;
function takePhoto(){if(game.turnAction||game.cameraBroken||game.photoDisabled>0||game.battery<photoCost())return;openAimCamera()}
function openAimCamera(){aimPoint={x:.5,y:.5};aimLocked=false;aimZoom=1;aimAngle=0;document.getElementById('aimModal').classList.add('show');document.getElementById('aimPlanet').className='aim-planet '+mission;document.getElementById('aimTitle').textContent='Lock onto '+(mission==='moon'?'the Moon':'Mars');document.getElementById('aimSceneLabel').textContent='LIVE VIEW · '+mission.toUpperCase();document.getElementById('aimZoom').value=1;document.getElementById('aimAngle').value=0;document.getElementById('aimZoomValue').textContent='1.0×';document.getElementById('aimAngleValue').textContent='0°';document.getElementById('aimError').classList.add('hidden');updateAimCamera()}
function closeAimCamera(){document.getElementById('aimModal').classList.remove('show')}
function resetAimCamera(){aimLocked=false;aimPoint={x:.5,y:.5};aimZoom=1;aimAngle=0;document.getElementById('aimZoom').value=1;document.getElementById('aimAngle').value=0;document.getElementById('aimZoomValue').textContent='1.0×';document.getElementById('aimAngleValue').textContent='0°';document.getElementById('aimError').classList.add('hidden');updateAimCamera()}
function updateAimCamera(){let r=document.getElementById('aimReticle');r.style.left=(aimPoint.x*100)+'%';r.style.top=(aimPoint.y*100)+'%';r.style.transform=`translate(-50%,-50%) rotate(${aimAngle}deg) scale(${1/aimZoom})`;let msg=`Aim position: ${Math.round(aimPoint.x*100)}% horizontal, ${Math.round(aimPoint.y*100)}% vertical`;document.getElementById('aimReadout').textContent=msg;document.getElementById('aimPosition').textContent=msg;document.getElementById('aimLockStatus').textContent=aimLocked?'🔒 AIM LOCKED — Your camera is steady.':'🔓 CAMERA UNLOCKED — Move to aim.';document.getElementById('aimLockStatus').classList.toggle('locked',aimLocked);document.getElementById('aimLockBtn').textContent=aimLocked?'🔓 UNLOCK CAMERA (L)':'🔒 LOCK CAMERA (L)'}
function toggleAimLock(){aimLocked=!aimLocked;updateAimCamera();document.getElementById('aimError').classList.add('hidden')}
function setAimZoom(v){aimZoom=Number(v);document.getElementById('aimZoomValue').textContent=aimZoom.toFixed(1)+'×';updateAimCamera()}
function setAimAngle(v){aimAngle=Number(v);document.getElementById('aimAngleValue').textContent=aimAngle+'°';updateAimCamera()}
document.getElementById('aimFrame').addEventListener('pointermove',e=>{if(aimLocked||!document.getElementById('aimModal').classList.contains('show'))return;let r=e.currentTarget.getBoundingClientRect();aimPoint.x=Math.max(0,Math.min(1,(e.clientX-r.left)/r.width));aimPoint.y=Math.max(0,Math.min(1,(e.clientY-r.top)/r.height));document.getElementById('aimError').classList.add('hidden');updateAimCamera()});
document.addEventListener('keydown',e=>{if(e.key.toLowerCase()==='l'&&document.getElementById('aimModal').classList.contains('show')&&!['INPUT','TEXTAREA'].includes(document.activeElement.tagName)){e.preventDefault();toggleAimLock()}});
function captureAimedPhoto(){if(!document.getElementById('aimModal').classList.contains('show'))return;if(!aimLocked){document.getElementById('aimError').textContent='Camera aim is not locked. Press L or click LOCK CAMERA before taking the photo.';document.getElementById('aimError').classList.remove('hidden');return}let frame=document.getElementById('aimFrame').getBoundingClientRect(),planet=document.getElementById('aimPlanet').getBoundingClientRect();let tx=(planet.left+planet.width/2-frame.left)/frame.width,ty=(planet.top+planet.height/2-frame.top)/frame.height;let dx=(aimPoint.x-tx)*aimZoom,dy=(aimPoint.y-ty)*aimZoom;if(Math.hypot(dx,dy)>=.19){document.getElementById('aimError').textContent='FRAME ERROR: '+(mission==='moon'?'The Moon':'Mars')+' is outside the picture window. Unlock, move your aim onto the planet, and lock again.';document.getElementById('aimError').classList.remove('hidden');return}closeAimCamera();if(!spend(photoCost()))return;game.stored+=game.camera.science;game.turnAction=true;game.lastAction='photo';log(`Camera aim locked. ${mission==='moon'?'Lunar':'Martian'} photo captured: +${game.camera.science} science stored onboard. It does not count until transmitted.`);completeAction()}
function queueMarsTransmission(amount,source='radio'){game.pending+=amount;game.pendingQueue.push({amount,arrivesTurn:game.turn+1,source});log(`${source==='boost'?'Boost transmission':'Transmission'} started: ${amount} science points are travelling to Earth. They will arrive after one full turn.`)}
function sendData(){if(game.turnAction||!hasLOS()||game.stored<=0||game.battery<radioCost())return;let amount=Math.min(game.stored,game.radio.capacity);if(!spend(radioCost()))return;game.stored-=amount;if(mission==='mars'){queueMarsTransmission(amount,'radio')}else{game.sent+=amount;log(`Data received on Earth: ${amount} science points added to your score.`)}game.turnAction=true;game.lastAction='send';completeAction()}
function recharge(){if(game.turnAction)return;let gain=0;if(game.power.id==='rtg')gain=35;else if(isShadow())gain=0;else gain=mission==='moon'?38:19;if(game.solarHalf>0&&game.power.id==='solar')gain=Math.floor(gain/2);game.battery=Math.min(100,game.battery+gain);game.turnAction=true;game.lastAction='recharge';log(gain?`Recharge complete. Battery +${gain}%.`:'No sunlight in this shadow. Solar panels cannot recharge.');completeAction()}
function completeAction(){if(game.done)return;updateFlight();setTimeout(()=>{if(game.done)return;advanceTurn()},350)}
function deliverMarsTransmissions(finalWindow=false){if(!game.pendingQueue?.length)return;let arrived=game.pendingQueue.filter(t=>t.arrivesTurn<=game.turn||(finalWindow&&t.arrivesTurn===game.turn+1));if(!arrived.length)return;let amount=arrived.reduce((sum,t)=>sum+t.amount,0);game.sent+=amount;game.pending=Math.max(0,game.pending-amount);game.pendingQueue=game.pendingQueue.filter(t=>!arrived.includes(t));log(`Mars data has reached Earth. +${Math.floor(amount)} science points confirmed.`)}
function advanceTurn(){deliverMarsTransmissions(false);if(game.sent>=game.goal){finish(true);return}if(game.turn>=game.maxTurns){deliverMarsTransmissions(true);if(game.sent>=game.goal){finish(true);return}finish(false,'Your final orbit is complete, but not enough science data reached Earth. Unsent data aboard the spacecraft cannot count toward the mission goal.');return}game.turn++;game.turnAction=false;if(game.photoDisabled>0)game.photoDisabled--;if(game.solarHalf>0)game.solarHalf--;if(game.turn===game.eventTurns[game.eventIndex]){let ev=game.events[game.eventIndex++];showEmergency(ev);return}updateFlight();log(`Entering turn ${game.turn} of ${game.maxTurns}.`)}
const emergencies={
 overheat:{title:'Cooling System Overload!',text:'Because there is no air in the vacuum of space, your ship cannot cool down! Your computer is overheating.',a:['Emergency Shut-Off','Turn off your camera and radio dish for 1 turn. Safe, but you lose this turn.'],b:['Push the Limits','Keep working while hot. 50% chance of double science; 50% chance your computer melts and the mission ends.'],run:(c)=>{if(c==='a'){game.turnAction=true;log('Emergency shut-off: systems cooling. You lost this turn.');advanceTurn()}else if(Math.random()<.5){let bonus=game.camera.science;game.stored+=bonus;game.brave+=15;log(`Risk survived! Camera produced double science (+${bonus} extra). Brave Choice +15.`);game.turnAction=false;updateFlight()}else{game.computerDead=true;finish(false,'The spacecraft computer melted after you pushed the overheating systems too far.');}}},
 storm:{title:'Solar Storm Warning!',text:'A giant burst of radiation from the Sun is hitting your spaceship!',a:['Safe Mode','Shut down electronics until the storm passes. Lose 1 turn; nothing breaks.'],b:['Risk It','Keep taking photos through the storm. Your camera has a 40% chance of frying permanently.'],run:(c)=>{if(game.shielded){log('Radiation shielding blocked the solar storm. No damage.');return}if(c==='a'){game.turnAction=true;log('Safe Mode activated. You lost this turn; systems are safe.');advanceTurn()}else if(Math.random()<.6){game.brave+=15;log('Camera survived the solar storm! Brave Choice +15.');updateFlight()}else{game.cameraBroken=true;log('The camera fried permanently. It cannot take more photos.');updateFlight()}}},
 freeze:{title:'Deep Shadow Freeze!',text:'Your ship flew into the freezing -150°C shadow behind the planet. The battery is freezing.',a:['Max Heater','Drain 30% battery immediately to keep the ship warm.'],b:['Save Battery','Keep the heater on low. Your camera lens freezes shut for the next 2 turns.'],run:(c)=>{if(c==='a'){game.battery=Math.max(0,game.battery-30);log('Heaters activated. Battery -30%.');if(game.battery<=0)finish(false,'The emergency heaters drained the last of the spacecraft battery.')}else{game.photoDisabled=3;log('Camera lens frozen. Photo capture is unavailable for the next 2 full turns.')}}},
 dust:{title:'Dust Cloud Alert!',text:'Thick, sticky space dust has coated your solar panels and camera lens.',a:['Vibrate Panels','Use 20% battery power to shake the dust off right away.'],b:['Wait It Out','Do nothing. Solar panels make half electricity for the next 2 turns.'],run:(c)=>{if(c==='a'){game.battery=Math.max(0,game.battery-20);game.dusty=false;log('Vibration cleared the dust. Battery -20%; panels restored.');if(game.battery<=0)finish(false,'The panel-cleaning vibration drained the battery completely.')}else{game.solarHalf=3;log('Dust settling. Solar recharge is halved for the next 2 full turns.')}}},
 micro:{title:'Space Rock Impact!',text:'A tiny space rock flying faster than a bullet is on a collision course with your radio dish!',a:['Thruster Dodge','Burn extra thruster fuel to steer away. The radio dish stays 100% fine.'],b:['Take the Hit','Save fuel and let the rock dent the dish. Radio signal becomes 25% slower for the rest of the game.'],run:(c)=>{if(c==='a'){if(game.fuel>=20){game.fuel-=20;log('Thruster dodge successful. Maneuvering fuel -20%; radio dish is safe.')}else{game.signalSlow=.75;log('Not enough maneuvering fuel to dodge. The radio dish was hit; signal speed is now 75%.')}}else{game.signalSlow=.75;log('Radio dish dented. Signal speed is now 75% for the rest of the mission.')}}},
 eclipse:{title:'Solar Eclipse!',text:'The planet is completely blocking the Sun. Your solar panels are making 0 electricity right now.',a:['Power Nap','Turn off everything except the main computer. Save battery; lose this turn.'],b:['Run on Reserve','Keep taking photos using stored battery power. If battery reaches 0%, you lose.'],run:(c)=>{if(game.power.id==='rtg'){log('RTG power is unaffected by the eclipse. Keep working normally.');return}if(c==='a'){game.turnAction=true;log('Power nap. Systems idle safely; you lose this turn.');advanceTurn()}else{log('Running on reserve power. Watch your battery.');updateFlight()}}},
 lag:{title:'Signal Lag Spike!',text:'Solar interference and distance have created a heavy delay in your radio signal to Earth.',a:['High-Power Boost','Spend 25% battery power to boost the radio and send stored photos right now.'],b:['Store & Wait','Keep the photos on your hard drive and wait 2 turns for the signal to clear.'],run:(c)=>{if(c==='a'){if(game.battery<=25){finish(false,'There was not enough battery for the high-power signal boost.');return}game.battery-=25;if(hasLOS()&&game.stored>0){let amount=Math.min(game.stored,game.radio.capacity);game.stored-=amount;if(mission==='mars'){queueMarsTransmission(amount,'boost')}else{game.sent+=amount;log(`Boost sent ${amount} science points immediately to Earth.`)}}else{log('Boost used, but the planet is blocking the signal. Data remains stored.')}updateFlight()}else{game.turnAction=true;log('Signal wait: the spacecraft stores its data and waits 2 turns.');advanceTurn();if(!game.done&&game.turn<game.maxTurns){game.turnAction=true;advanceTurn()}}}}
};
function showEmergency(key){let e=emergencies[key];if(!e)return;game.timerPaused=true;document.getElementById('emTitle').textContent=e.title;document.getElementById('emText').textContent=e.text;let choices=document.getElementById('emChoices');if(key==='storm'&&game.shielded){choices.innerHTML='<button class="choice success" onclick="resolveEmergency(\'a\')"><strong>✓ Shielding Activated</strong><small>Your radiation shielding blocks the storm. Continue with zero damage.</small></button>'; }else if(key==='eclipse'&&game.power.id==='rtg'){choices.innerHTML='<button class="choice success" onclick="resolveEmergency(\'a\')"><strong>✓ RTG Power Stable</strong><small>Your Nuclear Battery does not need sunlight. Continue at full power.</small></button>'}else{choices.innerHTML=`<button class="choice" onclick="resolveEmergency('a')"><strong>OPTION A · ${e.a[0]}</strong><small>${e.a[1]}</small></button><button class="choice" onclick="resolveEmergency('b')"><strong>OPTION B · ${e.b[0]}</strong><small>${e.b[1]}</small></button>`}document.getElementById('emergencyModal').classList.add('show');let left=15;document.getElementById('emCountdown').textContent=left;clearInterval(emTimer);emTimer=setInterval(()=>{left--;document.getElementById('emCountdown').textContent=left;if(left<=0){clearInterval(emTimer);resolveEmergency('a')}},1000)}
function resolveEmergency(c){if(!document.getElementById('emergencyModal').classList.contains('show'))return;clearInterval(emTimer);document.getElementById('emergencyModal').classList.remove('show');game.timerPaused=false;let key=game.events[game.eventIndex-1];emergencies[key].run(c);if(!game.done)updateFlight()}
function finish(win,reason=''){if(game.done)return;closeAimCamera();game.done=true;clearInterval(flightTimer);clearInterval(emTimer);document.getElementById('emergencyModal').classList.remove('show');show('ending');let cash=MISSION_BUDGET-game.cost;let budgetBonus=Math.max(0,cash);let total=game.sent+game.brave+budgetBonus;let success=win||game.sent>=game.goal;if(success){document.getElementById('crewCelebration').classList.remove('hidden');document.getElementById('endEyebrow').textContent='CHAPTER 04 · VICTORY ENDING';document.getElementById('endTitle').textContent='MISSION ACCOMPLISHED';document.getElementById('endTitle').style.color='var(--green)';document.getElementById('endStory').textContent=astronautName+' led the mission from NASA Mission Control. Screens light up with images of alien craters and possible underground water ice. The robotic scout delivered the maps NASA needs to plan safer future astronaut landing zones. '+(mission==='moon'?'The Moon survey is complete.':'The Mars survey is complete.')+' The science data has safely reached Earth.';document.getElementById('crewCelebrateText').textContent=astronautName+' and the Flight Director, Engineer, Science Lead and Communications Officer celebrate together as the final science data arrives safely at NASA Mission Control. The robotic scout stayed uncrewed; the whole team made the mission possible.'}else{document.getElementById('crewCelebration').classList.add('hidden');document.getElementById('endEyebrow').textContent='CHAPTER 04 · FAILURE ENDING';document.getElementById('endTitle').textContent='MISSION LOST';document.getElementById('endTitle').style.color='var(--red)';document.getElementById('endStory').textContent=astronautName+' and the Mission Control team could not complete the mission. '+(reason||'The spacecraft could not complete its mission.')+' Only science data received on Earth counts toward the goal. Review your report card, improve your spacecraft and launch again.'}document.getElementById('endSent').textContent=Math.floor(game.sent)+' pts';document.getElementById('endStored').textContent=Math.floor(game.stored+game.pending)+' pts';document.getElementById('endCash').textContent='$'+cash+'M';let tip='';if(game.sent<game.goal)tip=game.stored>0?'Tip: You collected data but did not transmit it all. Consider a larger radio dish or plan your send actions for clear signal windows.':'Tip: Try balancing camera power, radio power and battery recharge turns. A good photo is only useful if it reaches Earth.';else if(game.battery<25)tip='Tip: You reached the goal with very little battery left. Consider a Nuclear Battery (RTG) or schedule more recharge turns.';else if(game.stored>0)tip='Tip: You met the science goal, but '+Math.floor(game.stored)+' science points remained onboard. A larger radio dish could bring more data home.';else tip='Excellent mission planning. You balanced your budget, payload, battery and communication windows.';document.getElementById('endTip').textContent=tip;document.getElementById('endBonus').textContent=`Brave Choice bonus: +${game.brave} points · Leftover budget bonus: +${budgetBonus} points · Maneuvering fuel remaining: ${Math.round(game.fuel)}% · Total report-card bonus: ${total-game.sent} points. (Bonuses are recorded separately; the mission win condition is based on science transmitted to Earth.)`}
function restart(){clearInterval(flightTimer);clearInterval(emTimer);closeAimCamera();document.getElementById('crewCelebration').classList.add('hidden');selected={};showMissionSelect()}
</script></body></html>
