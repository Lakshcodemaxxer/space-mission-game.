.travel-destination:after{content:'';position:absolute;inset:25%;border:2px dotted #5b2c23;border-radius:50%;opacity:.5}.travel-route{position:absolute;left:14%;right:16%;top:53%;height:2px;border-top:2px dashed #72d8ff99;transform:rotate(-8deg)}.travel-craft{position:absolute;left:14%;top:42%;width:75px;height:31px;border-radius:8px;background:linear-gradient(#edf5fa,#839ab1);border:2px solid #d8e5f0;z-index:1;transform:rotate(-8deg);box-shadow:0 0 25px #6bdcff99;animation:deepCruise 7s ease-in-out infinite alternate}.travel-craft:before,.travel-craft:after{content:'';position:absolute;top:4px;width:30px;height:21px;background:repeating-linear-gradient(90deg,#174779 0 5px,#6eb5df 5px 7px);border:1px solid #8ab8d8}.travel-craft:before{left:-33px}.travel-craft:after{right:-33px}
@keyframes deepCruise{0%{left:14%;top:43%;transform:rotate(-8deg) scale(.8)}50%{top:35%;transform:rotate(-3deg) scale(1)}100%{left:72%;top:44%;transform:rotate(8deg) scale(.9)}}
.travel-caption{position:absolute;bottom:10px;left:0;right:0;text-align:center;color:#b8d7ee;font-size:12px;letter-spacing:2px}.crew-celebration{position:relative;overflow:hidden;margin:24px 0 10px;padding:24px 15px;border:1px solid #3b6e72;border-radius:16px;background:linear-gradient(135deg,#102b36,#17233a 60%,#332544);text-align:center}.crew-celebration h2{margin:4px 0 8px;color:#9af0c8}.crew-celebration>*:not(.celebrate-confetti){position:relative;z-index:1}.crew-row{display:flex;justify-content:center;align-items:end;gap:clamp(12px,3vw,35px);margin:20px auto 8px}.crew-person{width:65px;display:flex;flex-direction:column;align-items:center;gap:5px;font-size:11px;color:#d7e7f5}.crew-head{width:30px;height:30px;border-radius:50%;background:#d9ad8d;border:3px solid #f4d7bd}.crew-body{width:54px;height:48px;border-radius:18px 18px 8px 8px;background:linear-gradient(135deg,#f0f3f7,#8196b3);position:relative}.crew-body:before{content:'✦';position:absolute;left:21px;top:12px;color:#3185b7}.crew-person:nth-child(2) .crew-head{background:#8e6047}.crew-person:nth-child(2) .crew-body{background:linear-gradient(135deg,#e6edf6,#b65e48)}.crew-person:nth-child(3) .crew-head{background:#edc49e}.crew-person:nth-child(3) .crew-body{background:linear-gradient(135deg,#f4f2ec,#597a9f)}.crew-person:nth-child(4) .crew-head{background:#b77e5e}.crew-person:nth-child(4) .crew-body{background:linear-gradient(135deg,#f4f2ec,#3f8b83)}
